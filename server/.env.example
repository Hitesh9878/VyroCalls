PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/calling-app
# Long random string. Changing it signs everybody out.
JWT_SECRET=change-me-to-a-long-random-string
# The site URL people open in the browser (also the link inside emails)
CLIENT_ORIGIN=http://localhost:5173

# Set to 0 only if the server is NOT behind a proxy. On Render / Heroku / nginx leave it at 1.
# TRUST_PROXY=1
# NODE_ENV=production

# ---- Email (Brevo) ---------------------------------------------------------
# Leave BREVO_API_KEY empty in development and emails are printed in the server console.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Vyro Calls

# ---- TURN relay (needed for calls from phones on mobile data) ---------------
# Option A: any TURN server you run or rent (coturn, Twilio, Cloudflare, ...)
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Option B: Metered.ca (the server fetches fresh credentials for you)
# METERED_DOMAIN=yourapp.metered.live
# METERED_API_KEY=

# ---- Timings (milliseconds, all optional) -----------------------------------
# RING_TIMEOUT_MS=30000
# OFFLINE_RING_TIMEOUT_MS=60000
# DISCONNECT_GRACE_MS=20000     how long a connected call waits for a dropped connection to come back
# GROUP_MAX_PARTICIPANTS=6
# GROUP_INVITE_TIMEOUT_MS=60000
# CALL_EMAIL_COOLDOWN_MS=60000
# REQUEST_EMAIL_COOLDOWN_MS=300000
